<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.corerag-menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>CORERAG_PROJECT_ROOT/scripts/run_menubar.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>CORERAG_LOG_DIR/menubar.log</string>

    <key>StandardErrorPath</key>
    <string>CORERAG_LOG_DIR/menubar.log</string>

    <key>WorkingDirectory</key>
    <string>CORERAG_PROJECT_ROOT</string>
</dict>
</plist>
