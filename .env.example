# Absolute path to the folder where you will drop new files
INBOX_PATH=file location where you want to drop new files

# Absolute path to your Obsidian Vault root
VAULT_PATH=file location of your Obsidian Vault

# Absolute path to where processed original files should be archived
ARCHIVE_PATH=file location of where processed original files should be archived

# Gemini API Key for Intelligence/Classification
GOOGLE_API_KEY=your_api_key_here
