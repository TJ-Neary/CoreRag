# ── Required Paths ──────────────────────────────────────────────────────────────
# Absolute path to the folder where you will drop new files
INBOX_PATH=~/Desktop/Inbox

# Absolute path to your Obsidian Vault root
VAULT_PATH=~/Documents/ObsidianVault

# Absolute path to where processed original files should be archived
# Default: ~/Documents/PKM (matches config.py default)
ARCHIVE_PATH=~/Documents/PKM

# ── LLM Provider (pick one) ─────────────────────────────────────────────────────
# Set CORERAG_LLM_PROVIDER to choose: "ollama" (default), "gemini", "anthropic", "claude-cli", "gemini-cli", "codex-cli"
# CORERAG_LLM_PROVIDER=ollama
# CORERAG_LLM_MODEL=                  # Provider-specific default if empty

# Option 1: Local Ollama (default, no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:32b

# Option 2: Claude CLI (uses Claude Code CLI subprocess, Pro Max plan, no API key)
# CORERAG_LLM_PROVIDER=claude-cli
# CORERAG_LLM_MODEL=sonnet            # sonnet, opus, or haiku

# Option 3: Gemini CLI (uses Gemini CLI subprocess, no API key — uses CLI auth session)
# Best for large-context ingestion (1M+ token window with gemini-2.5-pro)
# CORERAG_LLM_PROVIDER=gemini-cli
# CORERAG_LLM_MODEL=gemini-2.5-pro       # gemini-2.5-pro, gemini-2.5-flash, etc.

# Option 4: Codex CLI (uses OpenAI Codex CLI subprocess, ChatGPT+ plan, no API key)
# CORERAG_LLM_PROVIDER=codex-cli
# CORERAG_LLM_MODEL=gpt-5.3-codex       # gpt-5.3-codex (default), o3, etc.

# Option 5: Gemini API (faster but sends text to Google)
# GOOGLE_API_KEY=your_api_key_here

# Option 6: Anthropic API (requires API key)
# CORERAG_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_api_key_here

# ── Database & Embeddings ───────────────────────────────────────────────────────
# Path to LanceDB vector database (created automatically)
CORERAG_DB_PATH=~/.corerag/lancedb

# Embedding model (runs locally via sentence-transformers)
# Default: BAAI/bge-m3 (1024d) — best retrieval quality
# Alternative: all-MiniLM-L6-v2 (384d) — lighter, faster
CORERAG_EMBEDDING_MODEL=BAAI/bge-m3

# Reranker model for search result quality (runs locally)
CORERAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# State directory for staging manifest, checkpoints, and runtime data
# CORERAG_STATE_DIR=~/.corerag/state

# ── API Security ────────────────────────────────────────────────────────────────
# Legacy single API key for /api/v1/* endpoints.
# NOTE: Per-agent authentication via SettingsManager is the current system (P8).
# Use the Settings tab in the dashboard to create per-agent API keys with
# per-action permission toggles. This variable is kept for backward compatibility.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CORERAG_API_KEY=your_secure_api_key_here

# ── Server Configuration ──────────────────────────────────────────────────────
# Preferred port for the dashboard + API server.
# If the port is in use, the server automatically tries the next available port.
# CORERAG_SERVER_PORT=8000

# ── Retrieval Enhancement ──────────────────────────────────────────────────────
# Contextual Retrieval — prepend LLM-generated context to each chunk before embedding
# CORERAG_CONTEXT_GENERATION=true
# Minimum chunk quality score (0.0-1.0); chunks below this are flagged
# CORERAG_CHUNK_QUALITY_THRESHOLD=0.3
# Corrective RAG — post-retrieval relevance filtering
# CORERAG_CORRECTIVE_RAG=true

# ── Restricted RAG Database ─────────────────────────────────────────────────────
# Path to second LanceDB instance for unredacted sensitive documents.
# Sensitive docs are indexed here (unredacted) in addition to main DB (redacted).
# Access controlled via per-agent search_restricted permission (SettingsManager).
# CORERAG_RESTRICTED_DB_PATH=~/.corerag/lancedb-restricted

# ── Multi-Vault Support ──────────────────────────────────────────────────────────
# Additional Obsidian vault paths beyond the primary VAULT_PATH.
# Format: "Name=/path/one,Work=/path/two" (comma-separated name=path pairs)
# CORERAG_VAULT_PATHS=

# ── Server Binding ───────────────────────────────────────────────────────────────
# IP address the server binds to. Default 127.0.0.1 (localhost only, most secure).
# Set to 0.0.0.0 only if you need LAN access (see SECURITY.md first).
# CORERAG_SERVER_HOST=127.0.0.1

# ── Retrieval Tuning ─────────────────────────────────────────────────────────────
# Maximum evidence chunks used for answer synthesis (GET /api/v1/answer).
# CORERAG_ANSWER_MAX_EVIDENCE=10

# Default source authority tier for documents with unknown origin.
# Values: "authoritative", "primary", "secondary", "unknown"
# CORERAG_SOURCE_AUTHORITY_DEFAULT=unknown

# ── Backup Configuration ──────────────────────────────────────────────────────────
# Auto-backup on server startup and before batch commits.
# Backups are stored in ~/.corerag/backups/ as tar.gz archives.
# CORERAG_BACKUP_ENABLED=true
# CORERAG_BACKUP_STARTUP_COOLDOWN=24    # Hours between startup backups
# CORERAG_BACKUP_COMMIT_COOLDOWN=1      # Hours between pre-commit backups
# CORERAG_BACKUP_MAX_COUNT=10           # Maximum backups to retain
# CORERAG_BACKUP_INTEGRITY_CHECK=true   # Verify backup integrity after creation
